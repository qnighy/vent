enum Option<T> { None, Some(T) }
struct Box<T> { value: T }

trait Show { fn show(self) -> String; }
trait Default { fn default() -> Self; }
trait Named { fn show(self) -> String; fn name() -> String { "?" } }

impl Show for Int { fn show(self) -> String { "int" } }
impl<T: Show> Show for Option<T> { fn show(self) -> String { "opt" } }
impl<T: Show> Show for Array<T> { fn show(self) -> String { "arr" } }
impl Default for Int { fn default() -> Int { 0 } }
impl<T> Default for Option<T> { fn default() -> Self { Option::None } }
impl Named for Int { fn show(self) -> String { "named" } }

// Impl declarations.
impl Show for Int { fn show(self) -> String { "again" } }
impl<T> Show for Box<T> {}
impl Show for String { fn show(self) -> Int { 1 } fn extra(self) {} }
impl Show for Bool { fn show(x: Bool) -> String { "bool" } }
impl Nope for Int {}
impl Eq for Box<Int> {}
impl<T> Default for Int { fn default() -> Int { 1 } }
impl Int { fn method(self) {} }
impl<T> Box<T> { fn get(self) -> T { self.value } fn get(self) -> T { self.value } }
impl Show for Show {}

fn needs_show<T: Show>(x: T) -> String { x.show() }
fn needs_eq<T: Eq>(x: T, y: T) -> Bool { x == y }
fn no_bound<T>(x: T, y: T) -> Bool {
    x.show();
    x.value;
    x == y
}

fn main() {
    needs_show(1);
    needs_show("s");
    needs_show([Option::Some(1)]);
    needs_show([Option::Some(main)]);
    needs_eq(1, 2);
    needs_eq(main, main);

    // Method resolution.
    "s".show();
    1.show();
    1.name();
    Int::name();
    1.missing();
    Int::missing();
    Option::Some(1).default();

    // The type implementing the trait must be known where the call is
    // checked: from the arguments or from the expected type.
    let a = Default::default();
    let b: Int = Default::default();
    let c: Option<Int> = Option::Some(Default::default());
    let d = Option::None.show();
    let e = needs_show(Option::None);
    let f: fn(Int) -> String = needs_show;
    let g = needs_show;
    var h = [];
    h.push(Default::default());
    h.push(1);
    let i: Int = 1 + Default::default();
    Show::show(Option::None);

    // A type determined later is too late, even in the same expression.
    let j: Array<Int> = [Default::default(), 1];
}
