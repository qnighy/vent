struct P { x: Int, y: Int }
struct Q { x: Int, y: Int }

fn main() {
    println([1, 2] == [1, 2]);
    println([1, 2] == [1, 2, 3]);
    println([1, 2] != [2, 1]);
    println([[1], []] == [[1], []]);
    println(P { x: 1, y: 2 } == P { x: 1, y: 2 });
    println(P { x: 1, y: 2 } == P { x: 1, y: 3 });
    println([P { x: 0, y: 0 }] == [P { x: 0, y: 0 }]);
    println(P { x: 1, y: 2 } == Q { x: 1, y: 2 });
}
