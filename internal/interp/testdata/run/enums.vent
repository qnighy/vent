// Enums and match.

enum Shape {
    Circle(Int),
    Rect(Int, Int),
    Empty,
}

enum Option<T> {
    None,
    Some(T),
}

struct Point { x: Int, y: Int }

fn area(s: Shape) -> Int {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0,
    }
}

fn find(a: Array<Int>, x: Int) -> Option<Int> {
    var i = 0;
    while i < a.len() {
        if a[i] == x {
            return Option::Some(i);
        }
        i += 1;
    }
    Option::None
}

fn is_round(s: Shape) -> Bool {
    match s {
        Shape::Circle(_) | Shape::Empty => true,
        Shape::Rect(w, h) | Shape::Rect(h, w) if w == 0 => true,
        Shape::Rect(_, _) => false,
    }
}

fn classify(p: Point) -> String {
    match p {
        Point { x: 0, y: 0 } => "origin",
        Point { x: 0, .. } => "on the y axis",
        Point { y: 0, .. } => "on the x axis",
        Point { x, y } if x == y => "diagonal",
        _ => "elsewhere",
    }
}

fn main() {
    println(area(Shape::Circle(2)));
    println(area(Shape::Rect(3, 4)));
    println(area(Shape::Empty));
    println(Shape::Rect(1, 2));
    println([is_round(Shape::Empty), is_round(Shape::Rect(1, 0)), is_round(Shape::Rect(1, 2))]);

    println(find([5, 6, 7], 6));
    println(find([5, 6, 7], 8));
    let none: Option<String> = Option::None;
    println(none);

    // Enums compare structurally.
    println(Option::Some(1) == Option::Some(1));
    println(Option::Some(1) == Option::None);
    println(Option::Some([1, 2]) != Option::Some([1]));

    // A variant with fields is a function.
    let some = Option::Some;
    println(some("x"));

    // Nested patterns, literals and guards.
    let pairs = [Option::Some(Option::Some(1)), Option::Some(Option::None), Option::None];
    var i = 0;
    while i < pairs.len() {
        let s = match pairs[i] {
            Option::Some(Option::Some(n)) if n > 0 => "positive",
            Option::Some(Option::Some(_)) => "other",
            Option::Some(Option::None) => "inner none",
            Option::None => "none",
        };
        println(s);
        i += 1;
    }
    println(classify(Point { x: 0, y: 0 }));
    println(classify(Point { x: 0, y: 5 }));
    println(classify(Point { x: 5, y: 0 }));
    println(classify(Point { x: 3, y: 3 }));
    println(classify(Point { x: 1, y: 2 }));

    match true {
        true => println("bools"),
        false => {}
    }
    let label = match "b" {
        "a" => 1,
        "b" => 2,
        _ => 3,
    };
    println(label);

    // Bindings hold copies.
    var arr = [1];
    let wrapped = Option::Some(arr);
    arr.push(2);
    match wrapped {
        Option::Some(a) => {
            var a = a;
            a.push(3);
            println(a);
        }
        Option::None => {}
    }
    println(arr);
    println(wrapped);
}
