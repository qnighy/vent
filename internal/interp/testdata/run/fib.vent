// Recursive and iterative Fibonacci.
fn fib(n: Int) -> Int {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn fib_iter(n: Int) -> Int {
    var a = 0;
    var b = 1;
    var i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i += 1;
    }
    a
}

fn main() {
    println(fib(20));
    println(fib_iter(90));
}
