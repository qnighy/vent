fn fizzbuzz(n: Int) -> String {
    if n % 15 == 0 {
        "FizzBuzz"
    } else if n % 3 == 0 {
        "Fizz"
    } else if n % 5 == 0 {
        "Buzz"
    } else {
        ""
    }
}

fn main() {
    var i = 1;
    while i <= 15 {
        let s = fizzbuzz(i);
        if s == "" { println(i) } else { println(s) }
        i += 1;
    }
}
