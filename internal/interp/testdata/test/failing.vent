struct P { x: Int, y: Int }

fn test_ok() {
    assert_eq(1 + 1, 2);
}

fn test_assert_eq_array() {
    println("captured output is shown on failure");
    assert_eq([1, 2, 3], [1, 2, 4]);
}

fn test_assert_eq_string() {
    assert_eq("a\n", "b");
}

fn test_assert_eq_struct() {
    assert_eq(P { x: 1, y: 2 }, P { x: 1, y: 3 });
}

fn test_assert_message() {
    assert(1 > 2, "math is broken");
}

fn test_assert_plain() {
    assert(false);
}

fn test_panic() {
    panic("something went wrong");
}

fn recurse(n: Int) -> Int {
    recurse(n + 1)
}

// An abort deep in recursion does not affect later tests.
fn test_stack_overflow() {
    recurse(0);
}

fn test_runtime_error() {
    let a = [1];
    a[1];
}

fn test_with_param(x: Int) {}

fn test_after_failures() {
    assert_eq(recurse_free(3), 6);
}

fn recurse_free(n: Int) -> Int {
    if n == 0 { 0 } else { n + recurse_free(n - 1) }
}
